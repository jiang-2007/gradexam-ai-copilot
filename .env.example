# ====== 大模型配置 ======
# 支持 OpenAI 兼容接口：Ollama / DeepSeek / 百度千帆 / OpenAI 等
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=deepseek-r1:7b

# Embedding 模型（本地 sentence-transformers，无需 API）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ====== RAG 配置 ======
CHUNK_SIZE=500
CHUNK_OVERLAP=50
VECTOR_STORE_PATH=./data/chroma_db

# ====== 全网检索（博查搜索 API）======
# 免费注册：https://open.bochaai.com → 获取 API Key
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search

# ====== 飞书机器人配置 ======
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=

# ====== 服务配置 ======
PORT=8000
HOST=0.0.0.0
